{
	"name": "yaxa-svelte",
	"version": "1.8.0",
	"description": "The Intuitive Svelte UI Library — Nuxt UI v4 equivalent for SvelteKit 2.7+ & Svelte 5 with automated SEO, dynamic OpenGraph cards, sitemaps, robots.txt, and Tailwind CSS v4.",
	"license": "MIT",
	"homepage": "https://yaxa.vercel.app",
	"repository": {
		"type": "git",
		"url": "https://github.com/FuntionalFrost/yaxa.git"
	},
	"bugs": {
		"url": "https://github.com/FuntionalFrost/yaxa/issues"
	},
	"packageManager": "pnpm@12.4.2",
	"engines": {
		"node": ">=24"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"svelte5",
		"nuxt-ui",
		"tailwind",
		"tailwindcss-v4",
		"ui-components",
		"seo",
		"opengraph",
		"sitemap",
		"robots"
	],
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./admin": {
			"types": "./dist/admin/index.d.ts",
			"svelte": "./dist/admin/index.js",
			"default": "./dist/admin/index.js"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"default": "./dist/server/index.js"
		},
		"./auth": {
			"types": "./dist/auth/index.d.ts",
			"svelte": "./dist/auth/index.js",
			"default": "./dist/auth/index.js"
		},
		"./db": {
			"types": "./dist/server/db/index.d.ts",
			"default": "./dist/server/db/index.js"
		},
		"./polar": {
			"types": "./dist/server/polar/index.d.ts",
			"default": "./dist/server/polar/index.js"
		},
		"./email": {
			"types": "./dist/server/email/index.d.ts",
			"default": "./dist/server/email/index.js"
		},
		"./storage": {
			"types": "./dist/server/storage/index.d.ts",
			"default": "./dist/server/storage/index.js"
		},
		"./vite": {
			"types": "./dist/vite/index.d.ts",
			"default": "./dist/vite/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"default": "./dist/testing/index.js"
		},
		"./yaxa.css": "./dist/styles/yaxa.css"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"package": "svelte-package",
		"prepack": "svelte-package",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"validate": "pnpm format:check && pnpm check && pnpm test",
		"verify": "pnpm format:check && pnpm lint && pnpm check && pnpm test && pnpm build",
		"release:check": "pnpm verify && pnpm package",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.1131.0",
		"@aws-sdk/s3-request-presigner": "^3.1131.0",
		"@eslint/js": "^10.0.1",
		"@iconify/json": "^2.2.525",
		"@libsql/client": "^0.18.0",
		"@lucide/svelte": "^1.46.0",
		"@neondatabase/serverless": "^1.1.0",
		"@polar-sh/sdk": "^0.49.0",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.1",
		"@vitest/coverage-v8": "^5.0.1",
		"better-auth": "^1.7.3",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "^30.0.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"resend": "^6.28.1",
		"super-sitemap": "^2.0.6",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-meta-tags": "^5.0.2",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.0",
		"zod": "^4.6.5"
	},
	"dependencies": {
		"bits-ui": "^2.19.0",
		"mode-watcher": "^1.1.0",
		"runed": "^0.37.1",
		"svelte-sonner": "^1.2.1",
		"tailwind-variants": "^3.3.1"
	},
	"peerDependencies": {
		"@aws-sdk/client-s3": ">=3.0.0",
		"@aws-sdk/s3-request-presigner": ">=3.0.0",
		"@libsql/client": ">=0.18.0",
		"@lucide/svelte": "^1.0.0",
		"@neondatabase/serverless": ">=1.1.0",
		"@polar-sh/sdk": ">=0.49.0",
		"@sveltejs/kit": "^2.0.0",
		"better-auth": ">=1.7.0",
		"drizzle-orm": ">=0.45.0",
		"resend": ">=6.27.0",
		"svelte": "^5.0.0",
		"zod": ">=4.0.0"
	},
	"peerDependenciesMeta": {
		"@aws-sdk/client-s3": {
			"optional": true
		},
		"@aws-sdk/s3-request-presigner": {
			"optional": true
		},
		"@libsql/client": {
			"optional": true
		},
		"@lucide/svelte": {
			"optional": true
		},
		"@neondatabase/serverless": {
			"optional": true
		},
		"@polar-sh/sdk": {
			"optional": true
		},
		"better-auth": {
			"optional": true
		},
		"drizzle-orm": {
			"optional": true
		},
		"resend": {
			"optional": true
		},
		"zod": {
			"optional": true
		}
	}
}
